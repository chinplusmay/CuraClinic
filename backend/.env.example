# Server Port (Render, Railway, etc. provide this automatically)
PORT=8080

# Database Configuration (Option 1: Individual fields)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinicflow
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# Database Configuration (Option 2: Full Connection String - used by TiDB Cloud, Aiven, Railway, Render)
# SPRING_DATASOURCE_URL=jdbc:mysql://host:port/database?useSSL=true&allowPublicKeyRetrieval=true&characterEncoding=utf8
# DATABASE_URL=mysql://user:pass@host:port/database

# Security & Tokens
JWT_SECRET=production-secret-key-curaclinic-must-be-long-enough-384bits-minimum-change-me
JWT_TTL_MINUTES=720

# Seeding demo data (creates Northbridge Family Clinic and owner@northbridgeclinic.com / clinicflow123)
SEED_DEMO_DATA=true

# Allowed Frontend Origins (comma-separated, or * for all)
FRONTEND_ORIGIN=http://localhost:5173,https://*.vercel.app

